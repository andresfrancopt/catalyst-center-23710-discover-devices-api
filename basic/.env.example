# Copy this file to ".env" (in this folder) and fill in your values.
# The real .env is never committed.

CATALYST_CENTER_BASE_URL=https://catalyst-center.example.com
CATALYST_CENTER_USERNAME=api-user
CATALYST_CENTER_PASSWORD=change-me

# true = check the controller's TLS certificate (use this in production).
# false = skip the check, for a lab with a self-signed certificate only.
CATALYST_CENTER_VERIFY_SSL=true

# Run get_credential_ids.py to find these two IDs, then paste them here.
CLI_CREDENTIAL_ID=
SNMP_CREDENTIAL_ID=
