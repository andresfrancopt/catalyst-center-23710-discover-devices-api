# Copy to .env and fill in. Never commit the real .env file.

# --- Catalyst Center API access ---
CATALYST_CENTER_BASE_URL=https://catalyst-center.example.com
CATALYST_CENTER_USERNAME=api-user
CATALYST_CENTER_PASSWORD=change-me
# Optional: PEM file of an internal CA. Leave empty to use the system CA store.
CATALYST_CENTER_CA_BUNDLE=
# Lab only: set to false to skip TLS certificate verification (e.g. a
# self-signed certificate). Leave unset/true for anything else. Cannot be
# combined with CATALYST_CENTER_CA_BUNDLE.
CATALYST_CENTER_VERIFY_SSL=false

# --- Discovery credential profiles ---
# Names of the profiles defined below, comma-separated.
# The FIRST profile is the default for devices that do not name one.
CREDENTIAL_PROFILES=default,branch

# Each profile lists Catalyst Center credentials, one or more per type,
# comma-separated. A value can be either:
#   - the credential ID (a UUID), or
#   - the credential's description as shown in Catalyst Center (e.g. CSS or RO).
# The scripts look the values up through the API before submitting and stop with
# a list of available credentials if one cannot be found. CLI values may also be
# a CLI username. Catalyst Center tries the credentials in the order given, only
# for the devices of that profile. These are not passwords.
# Variable pattern: CRED_<PROFILE>_CLI_IDS and CRED_<PROFILE>_SNMPV2_RO_IDS
CRED_DEFAULT_CLI_IDS=<cli-credential-id-or-description-1>
CRED_DEFAULT_SNMPV2_RO_IDS=<snmpv2-ro-credential-id-or-description-1>

CRED_BRANCH_CLI_IDS=<cli-credential-id-or-description-2>,<cli-credential-id-or-description-3>
CRED_BRANCH_SNMPV2_RO_IDS=<snmpv2-ro-credential-id-or-description-2>
